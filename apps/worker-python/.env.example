# Azure OpenAI (from Key Vault in production)
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Service Bus
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...
VALIDATION_REQUEST_QUEUE=tb-validation-request
VALIDATION_RESULT_QUEUE=tb-validation-result

# Cosmos DB
COSMOS_CONNECTION_STRING=AccountEndpoint=https://<account>.documents.azure.com:443/;AccountKey=...
COSMOS_DATABASE_NAME=tribalance

# Key Vault (optional — for production secret injection)
KEY_VAULT_URI=https://<vault>.vault.azure.net/
